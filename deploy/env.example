# Fichier /opt/tripbook/.env sur le serveur (deploy/deploy.sh le génère ; ce modèle sert pour une installation à la main).
# Un jeton par personne : openssl rand -hex 24. Le nom (avant les deux-points) signe les notes et les dépenses.
TRIP_TOKENS=alice:change-me,bob:change-me-too,claude:change-me-3
TRIP_AGENT=Claude                 # entrée de TRIP_TOKENS utilisée par l'assistant ; ses notes déclenchent une notification
TRIP_HOST=127.0.0.1
TRIP_PORT=8787
TRIP_URL=https://203-0-113-10.sslip.io       # URL publique (liens des notifications, image de la page de partage)
TRIP_SHARE_KEY=change-me-4        # lien de partage : /partage/?k=<clé>&nom=<prénom> (vide = partage désactivé)
